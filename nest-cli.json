{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "packages/server/src",
    "compilerOptions": {
        "tsConfigPath": "packages/server/tsconfig.json"
    },
    "monorepo": true,
    "root": "packages/server",
    "projects": {
        "payment": {
            "type": "application",
            "root": "packages/server",
            "entryFile": "main",
            "sourceRoot": "packages/server/src",
            "compilerOptions": {
                "tsConfigPath": "packages/server/tsconfig.json"
            }
        },
        "core": {
            "type": "library",
            "root": "packages/core",
            "entryFile": "index",
            "sourceRoot": "packages/core/src",
            "compilerOptions": {
                "tsConfigPath": "packages/core/tsconfig.json"
            }
        },
        "test": {
            "type": "application",
            "root": "packages/test",
            "entryFile": "test-main",
            "sourceRoot": "packages/test/src",
            "compilerOptions": {
                "tsConfigPath": "packages/test/tsconfig.json"
            }
        }
    }
}
